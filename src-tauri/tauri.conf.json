{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Veltrix",
  "mainBinaryName": "veltrix",
  "version": "0.1.0",
  "identifier": "app.veltrix",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Veltrix",
        "width": 1180,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "app", "dmg"],
    "category": "Utility",
    "shortDescription": "Free, open source download manager",
    "longDescription": "Veltrix is a free, open source download manager with segmented downloads, resume support, a persistent queue and browser integration.",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    }
  }
}
